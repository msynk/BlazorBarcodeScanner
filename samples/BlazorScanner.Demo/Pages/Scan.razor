@page "/scan"

<PageTitle>Live playground · BlazorScanner</PageTitle>

<h1>Live playground</h1>
<p class="lede">
    Every parameter of <code>&lt;BarcodeScanner&gt;</code> in one place. Changes apply to the
    running scanner without dropping the camera.
</p>

<div class="split">
    <div class="stack">
        <BarcodeScanner @ref="_scanner"
                        Formats="_formats"
                        Region="_region"
                        TargetFrameRate="_frameRate"
                        MaxProcessingSize="_processingSize"
                        DuplicateSuppressionWindow="TimeSpan.FromSeconds(_duplicateSeconds)"
                        Facing="_facing"
                        ShowControls="_showControls"
                        ShowStatusBar="_showStatus"
                        ShowReticle="_showReticle"
                        ShowMask="_showMask"
                        HighlightResults="_highlight"
                        EnableFileScanning="true"
                        AutoStart="true"
                        OnScan="HandleScan"
                        OnError="HandleError"
                        OnStatusChanged="HandleStatus"
                        OnDiagnostics="HandleDiagnostics" />

        <DiagnosticsPanel Diagnostics="_diagnostics"
                          FramesDecoded="_framesDecoded"
                          FramesWithSymbol="_framesWithSymbol" />
    </div>

    <div class="stack">
        <div class="card">
            <h3 style="margin-block-start:0;">Formats</h3>
            <p class="field__hint">
                Narrowing the set is the cheapest speed-up available: an unused symbology costs
                nothing because its decoder is never created.
            </p>
            <p class="field__hint">
                PDF417 stays inert until a specification symbol character table is registered;
                see the README for why.
            </p>
            <div class="grid grid--2" style="gap:0 1rem;">
                @foreach (var format in Formats)
                {
                    <label class="checkbox">
                        <input type="checkbox"
                               checked="@_formats.HasFlag(format)"
                               @onchange="e => ToggleFormat(format, (bool)(e.Value ?? false))" />
                        <span>@Label(format)</span>
                    </label>
                }
            </div>
            <div class="button-row" style="margin-block-start:0.75rem;">
                <button class="button" type="button" @onclick="() => SetFormats(BarcodeFormat.All)">All</button>
                <button class="button" type="button" @onclick="() => SetFormats(BarcodeFormat.AllMatrix)">Matrix only</button>
                <button class="button" type="button" @onclick="() => SetFormats(BarcodeFormat.AllLinear)">Linear only</button>
            </div>
        </div>

        <div class="card">
            <h3 style="margin-block-start:0;">Capture</h3>

            <div class="field">
                <label class="field__label" for="fps">Target frame rate: @_frameRate fps</label>
                <input id="fps" type="range" min="1" max="30" step="1"
                       value="@_frameRate" @onchange="e => _frameRate = ToInt(e, 15)" />
                <span class="field__hint">Above about twenty the extra frames rarely change how fast a symbol is found.</span>
            </div>

            <div class="field">
                <label class="field__label" for="size">Processing size: @_processingSize px</label>
                <input id="size" type="range" min="240" max="1280" step="40"
                       value="@_processingSize" @onchange="e => _processingSize = ToInt(e, 640)" />
                <span class="field__hint">Longest edge of the image the decoder sees. The browser scales the frame before it crosses into C#.</span>
            </div>

            <div class="field">
                <label class="field__label" for="region">Scan region: @((_regionFraction * 100).ToString("0"))%</label>
                <input id="region" type="range" min="20" max="100" step="5"
                       value="@(_regionFraction * 100)" @onchange="OnRegionChanged" />
            </div>

            <div class="field">
                <label class="field__label" for="dupe">Duplicate suppression: @_duplicateSeconds s</label>
                <input id="dupe" type="range" min="0" max="10" step="1"
                       value="@_duplicateSeconds" @onchange="e => _duplicateSeconds = ToInt(e, 2)" />
                <span class="field__hint">Zero reports every frame that decodes, which is useful for measuring throughput.</span>
            </div>

            <div class="field">
                <label class="field__label" for="facing">Preferred camera</label>
                <select id="facing" value="@_facing" @onchange="OnFacingChanged">
                    <option value="@CameraFacing.Rear">Rear</option>
                    <option value="@CameraFacing.Front">Front</option>
                    <option value="@CameraFacing.Any">Any</option>
                </select>
                <span class="field__hint">Applied the next time the camera is started.</span>
            </div>
        </div>

        <div class="card">
            <h3 style="margin-block-start:0;">Chrome</h3>
            <label class="checkbox"><input type="checkbox" checked="@_showControls" @onchange="e => _showControls = (bool)(e.Value ?? true)" /> Built-in controls</label>
            <label class="checkbox"><input type="checkbox" checked="@_showStatus" @onchange="e => _showStatus = (bool)(e.Value ?? true)" /> Status bar</label>
            <label class="checkbox"><input type="checkbox" checked="@_showReticle" @onchange="e => _showReticle = (bool)(e.Value ?? true)" /> Reticle</label>
            <label class="checkbox"><input type="checkbox" checked="@_showMask" @onchange="e => _showMask = (bool)(e.Value ?? true)" /> Dim outside the region</label>
            <label class="checkbox"><input type="checkbox" checked="@_highlight" @onchange="e => _highlight = (bool)(e.Value ?? true)" /> Highlight decoded symbol</label>
        </div>

        <div class="card">
            <h3 style="margin-block-start:0;">Programmatic control</h3>
            <p class="field__hint">The same operations the built-in controls perform, driven from the page.</p>
            <div class="button-row">
                <button class="button" type="button" @onclick="() => _scanner!.StartAsync()">Start</button>
                <button class="button" type="button" @onclick="() => _scanner!.StopAsync()">Stop</button>
                <button class="button" type="button" @onclick="() => _scanner!.Pause()">Pause</button>
                <button class="button" type="button" @onclick="() => _scanner!.Resume()">Resume</button>
                <button class="button" type="button" @onclick="OpenPicker">Scan an image</button>
            </div>
            <p class="field__hint" style="margin-block-start:0.6rem;">
                Status: <span class="pill">@(_scanner?.Status.ToString() ?? "-")</span>
                @if (_scanner?.Camera is { } camera)
                {
                    <span class="pill pill--muted">@camera.Width×@camera.Height</span>
                }
            </p>
        </div>

        @if (_error is not null)
        {
            <div class="note note--warning">
                <strong>@_error.Kind</strong> — @_error.Message
            </div>
        }
    </div>
</div>

<div style="margin-block-start:1.25rem;">
    <ResultLog Results="_results" OnClear="() => _results.Clear()" />
</div>

@code {
    private static readonly BarcodeFormat[] Formats =
    [
        BarcodeFormat.QrCode, BarcodeFormat.DataMatrix, BarcodeFormat.Code128, BarcodeFormat.Code39,
        BarcodeFormat.Ean13, BarcodeFormat.Ean8, BarcodeFormat.UpcA, BarcodeFormat.UpcE, BarcodeFormat.Itf,
        BarcodeFormat.Pdf417,
    ];

    private readonly List<BarcodeResult> _results = [];

    private BarcodeScanner? _scanner;
    private BarcodeFormat _formats = BarcodeFormat.All;
    private ScanRegion _region = ScanRegion.CenteredSquare(0.7);
    private double _regionFraction = 0.7;
    private CameraFacing _facing = CameraFacing.Rear;
    private ScanDiagnostics _diagnostics;
    private ScannerException? _error;
    private long _framesDecoded;
    private long _framesWithSymbol;

    private int _frameRate = 15;
    private int _processingSize = 640;
    private int _duplicateSeconds = 2;
    private bool _showControls = true;
    private bool _showStatus = true;
    private bool _showReticle = true;
    private bool _showMask = true;
    private bool _highlight = true;

    private void HandleScan(BarcodeResult result)
    {
        _results.Insert(0, result);
        if (_results.Count > 40)
        {
            _results.RemoveAt(_results.Count - 1);
        }

        StateHasChanged();
    }

    private void HandleError(ScannerException error)
    {
        _error = error;
        StateHasChanged();
    }

    private void HandleStatus(ScannerStatus status)
    {
        if (status != ScannerStatus.Faulted)
        {
            _error = null;
        }

        StateHasChanged();
    }

    private void HandleDiagnostics(ScanDiagnostics diagnostics)
    {
        _diagnostics = diagnostics;
        _framesDecoded++;
        if (diagnostics.Decoded)
        {
            _framesWithSymbol++;
        }

        StateHasChanged();
    }

    private void ToggleFormat(BarcodeFormat format, bool enabled)
    {
        _formats = enabled ? _formats | format : _formats & ~format;
    }

    private void SetFormats(BarcodeFormat formats) => _formats = formats;

    private void OnRegionChanged(ChangeEventArgs args)
    {
        _regionFraction = Math.Clamp(ToInt(args, 70) / 100.0, 0.2, 1.0);
        _region = _regionFraction >= 0.999 ? ScanRegion.Full : ScanRegion.CenteredSquare(_regionFraction);
    }

    private void OnFacingChanged(ChangeEventArgs args)
    {
        if (Enum.TryParse<CameraFacing>(args.Value?.ToString(), out var facing))
        {
            _facing = facing;
        }
    }

    private Task OpenPicker() => _scanner is null ? Task.CompletedTask : _scanner.OpenFilePickerAsync();

    private static int ToInt(ChangeEventArgs args, int fallback) =>
        int.TryParse(args.Value?.ToString(), out var value) ? value : fallback;

    private static string Label(BarcodeFormat format) => format switch
    {
        BarcodeFormat.QrCode => "QR Code",
        BarcodeFormat.DataMatrix => "Data Matrix",
        BarcodeFormat.Code128 => "Code 128",
        BarcodeFormat.Code39 => "Code 39",
        BarcodeFormat.Ean13 => "EAN-13",
        BarcodeFormat.Ean8 => "EAN-8",
        BarcodeFormat.UpcA => "UPC-A",
        BarcodeFormat.UpcE => "UPC-E",
        BarcodeFormat.Itf => "ITF",
        BarcodeFormat.Pdf417 => "PDF417 (needs table)",
        _ => format.ToString(),
    };
}
